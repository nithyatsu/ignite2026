{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "postgresPassword": { "type": "securestring" },
    "postgresHost": { "type": "string" }
  },
  "resources": [
    {
      "type": "Microsoft.ContainerInstance/containerGroups",
      "apiVersion": "2023-05-01",
      "name": "vote",
      "location": "eastus2",
      "properties": {
        "sku": "Confidential",
        "osType": "Linux",
        "restartPolicy": "Always",
        "confidentialComputeProperties": { "ccePolicy": "" },
        "containers": [
          {
            "name": "redis",
            "properties": {
              "image": "ghcr.io/nithyatsu/redis@sha256:ca0acbb137c1dc3339c8b147a58fd6f42775d4599327b50e7b116c23de501af2",
              "ports": [],
              "resources": { "requests": { "cpu": 1, "memoryInGB": 1 } }
            }
          },
          {
            "name": "vote",
            "properties": {
              "image": "ghcr.io/nithyatsu/example-voting-app-vote:047c81d1f93c53cad6074db9ad525bf37a541178",
              "ports": [ { "protocol": "TCP", "port": 80 } ],
              "resources": { "requests": { "cpu": 1, "memoryInGB": 1 } },
              "environmentVariables": [
                { "name": "REDIS_HOST", "value": "localhost" },
                { "name": "REDIS_PORT", "value": "6379" }
              ]
            }
          },
          {
            "name": "worker",
            "properties": {
              "image": "ghcr.io/nithyatsu/example-voting-app-worker:047c81d1f93c53cad6074db9ad525bf37a541178",
              "ports": [],
              "resources": { "requests": { "cpu": 1, "memoryInGB": 1 } },
              "environmentVariables": [
                { "name": "POSTGRES_DB", "value": "votes" },
                { "name": "POSTGRES_HOST", "value": "[parameters('postgresHost')]" },
                { "name": "POSTGRES_PASSWORD", "value": "[parameters('postgresPassword')]" },
                { "name": "POSTGRES_PORT", "value": "5432" },
                { "name": "POSTGRES_SSLMODE", "value": "prefer" },
                { "name": "POSTGRES_USER", "value": "myadmin" },
                { "name": "REDIS_HOST", "value": "localhost" },
                { "name": "REDIS_PORT", "value": "6379" }
              ]
            }
          }
        ],
        "ipAddress": { "type": "Private", "ports": [ { "protocol": "TCP", "port": 80 } ] }
      }
    }
  ]
}
